# --- Web app login (npm run web) ---
ADMIN_EMAIL=you@youragency.com
ADMIN_PASSWORD=
# Any long random string; keeps you logged in across server restarts.
SESSION_SECRET=
# PORT=3000

# --- Facebook (post to a Page you admin) ---
# Page ID: facebook.com/your-page -> About -> Page transparency, or Graph API Explorer
FB_PAGE_ID=
# Long-lived PAGE access token with pages_manage_posts + pages_read_engagement.
# How to get one: see README "Getting a Facebook token".
FB_PAGE_ACCESS_TOKEN=

# --- Make.com alternative (no Meta app needed) ---
# Create a scenario starting with a "Custom webhook" module, paste its URL here.
# ReelWorks will POST multipart form-data: file (the mp4), caption, client.
MAKE_WEBHOOK_URL=

# --- Optional overrides ---
# Point Playwright at a specific Chrome/Chromium binary (usually not needed).
CHROMIUM_PATH=
# Point Remotion's renderer at a specific browser binary (usually not needed;
# Remotion downloads its own headless shell on first render).
REMOTION_CHROME=
